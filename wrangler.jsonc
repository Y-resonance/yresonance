{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yresonance",
  "account_id": "17c619232f5d84567cd69896e892f326",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "production",
    "QUERY_CACHE_NAME": "yresonance-query-cache",
    "CLOUDFLARE_ACCOUNT_ID": "17c619232f5d84567cd69896e892f326",
    "R2_BUCKET_NAME": "yresonance-data",
    "DATA_SOURCE_BASE_URL": "r2://yresonance-data",
    "QUERY_DATA_SOURCE_BASE_URL": "r2://yresonance-data",
  },
  "secrets": {
    "required": [
      "CLERK_SECRET_KEY",
      "INTERNAL_R2_SIGNING_SECRET",
      "UPLOAD_SIGNING_SECRET",
      "RESET_ADMIN_TOKEN",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yresonance-app",
      "database_id": "320d2de2-61ae-4e18-97b0-839ae748f2b9",
      "preview_database_id": "e75e6c03-a9cf-404a-8d10-14d20f393697",
      "migrations_dir": "drizzle",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "QUERY_CACHE",
      "id": "54b4bb2fee024effa8e3bc5f995aea17",
      "preview_id": "47783b0d496e4257bb1fe168cfbf28f6",
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "PRODUCT_ANALYTICS",
      "dataset": "yresonance_product",
    },
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "yresonance-data",
      "preview_bucket_name": "yresonance-data-preview",
    },
  ],
  "containers": [
    {
      "class_name": "QueryEngineContainer",
      "image": "./Dockerfile",
      "max_instances": 5,
      "instance_type": "basic",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUERY_ENGINE",
        "class_name": "QueryEngineContainer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QueryEngineContainer"],
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "yresonance.com",
      "custom_domain": true,
    },
  ],
  "env": {
    "preview": {
      "name": "yresonance-preview",
      "routes": [],
      "vars": {
        "APP_ENV": "preview",
        "QUERY_CACHE_NAME": "yresonance-query-cache-preview",
        "CLOUDFLARE_ACCOUNT_ID": "17c619232f5d84567cd69896e892f326",
        "R2_BUCKET_NAME": "yresonance-data-preview",
        "DATA_SOURCE_BASE_URL": "r2://yresonance-data-preview",
        "QUERY_DATA_SOURCE_BASE_URL": "r2://yresonance-data-preview",
      },
      "secrets": {
        "required": [
          "CLERK_SECRET_KEY",
          "INTERNAL_R2_SIGNING_SECRET",
          "UPLOAD_SIGNING_SECRET",
          "RESET_ADMIN_TOKEN",
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "yresonance-app-preview",
          "database_id": "e75e6c03-a9cf-404a-8d10-14d20f393697",
          "migrations_dir": "drizzle",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "QUERY_CACHE",
          "id": "47783b0d496e4257bb1fe168cfbf28f6",
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "PRODUCT_ANALYTICS",
          "dataset": "yresonance_product_preview",
        },
      ],
      "r2_buckets": [
        {
          "binding": "DATA",
          "bucket_name": "yresonance-data-preview",
        },
      ],
      "containers": [
        {
          "class_name": "QueryEngineContainer",
          "image": "./Dockerfile",
          "max_instances": 2,
          "instance_type": "basic",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "QUERY_ENGINE",
            "class_name": "QueryEngineContainer",
          },
        ],
      },
    },
  },
}
