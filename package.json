{
  "name": "yresonance",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run prepare:preview-example && vite dev",
    "build": "bun run prepare:preview-example && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build",
    "preview": "vite preview",
    "deploy": "bun run deploy:preview",
    "deploy:production": "bun run build && bun run deploy:built",
    "deploy:built": "bun run db:migrate:production && wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry-run": "wrangler deploy --dry-run --config dist/server/wrangler.json",
    "deploy:preview": "CLOUDFLARE_ENV=preview bun run build && bun run deploy:preview:built",
    "deploy:preview:built": "bun run db:migrate:preview && wrangler deploy --config dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:check": "migration_state=$(mktemp -d /tmp/yresonance-d1-migrations.XXXXXX) && CI=1 wrangler d1 migrations apply DB --local --persist-to \"$migration_state\"",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote",
    "reset": "bun run scripts/reset-environment.ts",
    "generate-routes": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false bun run scripts/generate-routes.ts",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --strict-vars false",
    "types:check": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --strict-vars false --check",
    "typecheck": "bun run prepare:preview-example && bun run generate-routes && tsc --noEmit",
    "test": "vitest --run",
    "test:clickhouse": "vitest --run --config vitest.clickhouse.config.ts",
    "test:integration": "bun run prepare:preview-example && vitest --run --config vitest.integration.config.ts",
    "test:e2e": "bun run test:e2e:ui && bun run test:e2e:clerk",
    "test:e2e:ui": "playwright test --config playwright.ui.config.ts",
    "test:e2e:clerk": "playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run types:check && bun run db:migrate:check && bun run test",
    "prepare:preview-example": "bun run scripts/prepare-preview-example.ts",
    "build:branch-preview": "bun run scripts/preview-resources.ts prepare && YRESONANCE_PREVIEW_CONFIG=.wrangler-branch.json bun run build",
    "deploy:branch-preview": "wrangler preview --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/tanstack-react-start": "^1.5.9",
    "@cloudflare/containers": "^0.3.7",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/geist": "^5.3.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@posthog/react": "^1.11.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-table": "^9.2.4",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.37.0",
    "posthog-js": "^1.435.8",
    "posthog-node": "^5.55.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-grid-layout": "^2.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.31",
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@playwright/test": "^1.58.2",
    "@posthog/rollup-plugin": "^1.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.3.10",
    "@types/node": "26.4.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "^0.31.10",
    "oxc-transform-react": "^0.148.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vite-imagetools": "^12.0.1",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  }
}
