{
  "name": "@yresonance-dev/core",
  "version": "0.0.0",
  "description": "Self-hostable dashboard builder. Install it, write a yresonance.config.ts and build it for your own infrastructure.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Y-resonance/yresonance.git"
  },
  "bin": {
    "yresonance": "bin/yresonance.js"
  },
  "files": [
    "bin",
    "dist/platform",
    "dist/types/src",
    "drizzle",
    "public",
    "src",
    ".generated/preview-example.json",
    "tsr.config.json",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "exports": {
    "./config": {
      "types": "./dist/types/src/platform/config.d.ts",
      "default": "./src/platform/config.ts"
    },
    "./adapters/*": {
      "types": "./dist/types/src/platform/adapters/*.d.ts",
      "default": "./src/platform/adapters/*.ts"
    },
    "./ui": {
      "types": "./dist/types/src/platform/ui.d.ts",
      "default": "./src/platform/ui.ts"
    },
    "./vite": {
      "types": "./dist/types/src/platform/vite.d.ts",
      "default": "./dist/platform/vite.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run scripts/check-local-postgres.ts && bun run prepare:preview-example && vite dev",
    "build": "bun run prepare:preview-example && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build",
    "preview": "vite preview",
    "deploy": "bun run deploy:preview",
    "deploy:production": "bun run build && bun run deploy:built",
    "deploy:built": "bun run db:migrate:production && wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry-run": "wrangler deploy --dry-run --config dist/server/wrangler.json",
    "deploy:preview": "CLOUDFLARE_ENV=preview bun run build && bun run deploy:preview:built",
    "deploy:preview:built": "bun run db:migrate:preview && wrangler deploy --config dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:check": "DATABASE_URL=postgres://yresonance:yresonance@localhost:5432/yresonance_test drizzle-kit migrate",
    "db:migrate:local": "DATABASE_URL=postgres://yresonance:yresonance@localhost:5432/yresonance drizzle-kit migrate",
    "db:migrate:preview": "bun run scripts/migrate.ts POSTGRES_PREVIEW_SHARED_URL",
    "db:migrate:production": "bun run scripts/migrate.ts POSTGRES_PRODUCTION_URL",
    "reset": "bun run cloud/scripts/reset-environment.ts",
    "generate-routes": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false bun run scripts/generate-routes.ts",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --config cloud/wrangler.jsonc --strict-vars false",
    "types:check": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --config cloud/wrangler.jsonc --strict-vars false --check",
    "typecheck": "bun run prepare:preview-example && bun run generate-routes && tsc --noEmit",
    "test": "vitest --run",
    "test:clickhouse": "vitest --run --config vitest.clickhouse.config.ts",
    "test:integration": "bun run prepare:preview-example && vitest --run --config vitest.postgres.config.ts && vitest --run --config vitest.integration.config.ts",
    "test:e2e": "bun run test:e2e:ui && bun run test:e2e:clerk",
    "test:e2e:ui": "playwright test --config playwright.ui.config.ts",
    "test:e2e:clerk": "playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run types:check && bun run test",
    "prepare:preview-example": "bun run scripts/prepare-preview-example.ts",
    "build:branch-preview": "bun run cloud/scripts/preview-resources.ts prepare && YRESONANCE_PREVIEW_CONFIG=cloud/.wrangler-branch.json bun run build",
    "deploy:branch-preview": "wrangler preview --config dist/server/wrangler.json",
    "build:package": "bun run scripts/build-package.ts",
    "prepack": "bun run build:package",
    "test:package": "bun run scripts/check-package.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/tanstack-react-start": "^1.5.9",
    "@cloudflare/containers": "^0.3.7",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/geist": "^5.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@posthog/react": "^1.11.3",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "@tanstack/react-table": "^9.2.4",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "6.3.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.37.0",
    "openid-client": "^6.9.0",
    "oxc-transform-react": "^0.158.0",
    "pg": "^8.16.3",
    "posthog-js": "^1.435.8",
    "posthog-node": "^5.55.0",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "3.11.2",
    "remark-breaks": "^4.0.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite-imagetools": "^12.0.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.31",
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@playwright/test": "^1.58.2",
    "@posthog/rollup-plugin": "^1.6.1",
    "@types/bun": "^1.3.10",
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "packageManager": "bun@1.4.5"
}
